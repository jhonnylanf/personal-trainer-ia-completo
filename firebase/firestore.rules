rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function owner(uid){return request.auth!=null&&request.auth.uid==uid;}
 match /users/{uid}/{doc=**}{allow read,write:if owner(uid);}
 match /exercises/{id}{allow read:if resource.data.status=='published';allow write:if request.auth!=null&&request.auth.token.admin==true;}
 match /admin_audit/{id}{allow read,create:if request.auth!=null&&request.auth.token.admin==true;allow update,delete:if false;}
}}
